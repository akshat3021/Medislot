# ==============================================================================
# Medislot Environment Configuration Example
# Copy to .env or export in your shell before running medislot
# ==============================================================================

# PostgreSQL Connection String (e.g., Supabase Session Pooler URL)
# Note: For Supabase on IPv4 networks, use the Session Pooler URI with ?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Test Database Connection (WARNING: `make test` will erase the "medislot" schema here!)
TEST_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Hospital Local Timezone (defaults to Asia/Kolkata if omitted)
HOSPITAL_TZ=Asia/Kolkata

# HTTP Server Port (defaults to 8080 if omitted)
PORT=8080
